    <resultMap id="messageResultMap" type="kr.pe.ryudaewan.brano.message.service.MessageVo"
               extends="kr.pe.ryudaewan.brano.base.dao.CommonDao.commonResultMap">
        <id column="message_id" property="messageId"/>
        <result column="locale" property="locale"/>
        <result column="email" property="email"/>
    </resultMap>

    <select id="selectMessageByMessageKeyAndLocale" resultMap="messageResultMap"
            parameterType="kr.pe.ryudaewan.brano.message.service.MessageVo">
        /* MessageDao.selectMessageByMessageKeyAndLocale */
        select u.message_id
        , u.locale
        , u.message_key
        , u.message_content
        , u.created_at
        , u.updated_at
        , u.deleted_at
        from messages u
        where u.locale = #{locale}
        and u.message_key = #{messageKey}
        and u.deleted_at is null
    </select>

